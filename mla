import math
import torch
import torch.nn as nn
import torch.nn.functional as F


class FeatureTokenizer(nn.Module):
    def __init__(self, obs_dim: int, embed_dim: int):
        super().__init__()
        self.obs_dim = obs_dim
        self.embed_dim = embed_dim
        self.weight = nn.Parameter(torch.randn(obs_dim, embed_dim) * 0.02)
        self.bias = nn.Parameter(torch.zeros(obs_dim, embed_dim))

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        tokens = x.unsqueeze(-1) * self.weight.unsqueeze(0) + self.bias.unsqueeze(0)
        return tokens


class MultiHeadLatentAttention(nn.Module):
    def __init__(
        self,
        obs_dim: int,
        embed_dim: int = 128,
        num_heads: int = 8,
        ff_hidden_dim: int = 256,
        dropout: float = 0.1,
        use_cls_token: bool = False
    ):
        super().__init__()
        assert embed_dim % num_heads == 0, "embed_dim must be divisible by num_heads"

        self.obs_dim = obs_dim
        self.embed_dim = embed_dim
        self.num_heads = num_heads
        self.head_dim = embed_dim // num_heads
        self.use_cls_token = use_cls_token

        self.tokenizer = FeatureTokenizer(obs_dim, embed_dim)

        if use_cls_token:
            self.cls_token = nn.Parameter(torch.zeros(1, 1, embed_dim))
        else:
            self.cls_token = None

        self.q_proj = nn.Linear(embed_dim, embed_dim, bias=False)
        self.k_proj = nn.Linear(embed_dim, embed_dim, bias=False)
        self.v_proj = nn.Linear(embed_dim, embed_dim, bias=False)
        self.out_proj = nn.Linear(embed_dim, embed_dim)

        self.norm1 = nn.LayerNorm(embed_dim)
        self.norm2 = nn.LayerNorm(embed_dim)

        self.ffn = nn.Sequential(
            nn.Linear(embed_dim, ff_hidden_dim),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(ff_hidden_dim, embed_dim)
        )

        self.dropout = nn.Dropout(dropout)
        self.last_attn = None

    def _split_heads(self, x: torch.Tensor) -> torch.Tensor:
        B, T, E = x.shape
        x = x.view(B, T, self.num_heads, self.head_dim)
        return x.permute(0, 2, 1, 3)

    def _merge_heads(self, x: torch.Tensor) -> torch.Tensor:
        B, H, T, D = x.shape
        x = x.permute(0, 2, 1, 3).contiguous()
        return x.view(B, T, H * D)

    def forward(self, x: torch.Tensor, return_attention: bool = False):
        tokens = self.tokenizer(x)

        if self.use_cls_token:
            B = tokens.size(0)
            cls = self.cls_token.expand(B, -1, -1)
            tokens = torch.cat([cls, tokens], dim=1)

        residual = tokens
        x_norm = self.norm1(tokens)

        Q = self._split_heads(self.q_proj(x_norm))
        K = self._split_heads(self.k_proj(x_norm))
        V = self._split_heads(self.v_proj(x_norm))

        scores = torch.matmul(Q, K.transpose(-2, -1)) / math.sqrt(self.head_dim)
        attn = F.softmax(scores, dim=-1)
        attn = self.dropout(attn)

        self.last_attn = attn.detach()

        context = torch.matmul(attn, V)
        context = self._merge_heads(context)
        attn_out = self.out_proj(context)

        x = residual + self.dropout(attn_out)

        residual = x
        x_norm = self.norm2(x)
        x = residual + self.dropout(self.ffn(x_norm))

        if self.use_cls_token:
            pooled = x[:, 0, :]
        else:
            pooled = x.mean(dim=1)

        if return_attention:
            return pooled, self.last_attn
        return pooled
